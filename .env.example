# ==============================================================================
# Amazon Furniture — Environment Variables Guide
# ==============================================================================

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/amazon_furniture?retryWrites=true&w=majority

# Cloudinary CDN for Product Images
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Business Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sales@amazonfurniture.eg
SMTP_PASS=your_app_password
EMAIL_FROM="AMAZON للأثاث المكتبي" <sales@amazonfurniture.eg>
ADMIN_EMAIL=admin@amazonfurniture.eg

# Marketing Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

