# بيئة التشغيل والخادم
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# مفتاح تشفير JWT (يجب أن يكون معقداً في بيئة الإنتاج)
JWT_SECRET=super_secret_jwt_key_min_32_characters_random_string_2026!
JWT_EXPIRES_IN=7d

# خدمة البريد الإلكتروني (Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=support@amazonfurniture.eg
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="Amazon Furniture <support@amazonfurniture.eg>"
