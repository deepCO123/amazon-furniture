# ============================================================
# Amazon Furniture — PRODUCTION Environment Variables
# ============================================================
# ⚠️  NEVER commit this file with real values to Git!
# ⚠️  Use secrets manager (e.g., Railway variables, Render env, Docker secrets) in production
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# ── JWT (CRITICAL: Must be strong random string, min 64 chars) ─────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ── MongoDB Atlas ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Email (Gmail App Password) ────────────────────────────────
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM="Amazon Furniture <your-email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=admin@your-domain.com

# ── Cloudinary (required for image uploads) ──────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Google OAuth 2.0 (required for Google login) ─────────────
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# ── Optional: Custom backup directory ────────────────────────
# DATA_DIR=/path/to/persistent/data/directory
