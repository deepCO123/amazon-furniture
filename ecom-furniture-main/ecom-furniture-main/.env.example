# ==============================================================================
# Amazon Furniture — Frontend Environment Variables Example
# Duplicate this file as .env.local for local development or configure in Vercel
# ==============================================================================

# Backend API URL (Express server)
# In development: http://localhost:5000
# In production on Vercel: https://api.yourdomain.com or https://your-backend.railway.app
NEXT_PUBLIC_BACKEND_URL=

# Production Storefront Canonical URL (without trailing slash)
# Example: https://amazonfurniture.eg or https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# JWT Secret (Server-side verification only — MUST match backend JWT_SECRET)
JWT_SECRET=

# Email notifications (Server-side only — optional if backend handles all emails)
ADMIN_NOTIFICATION_EMAIL=
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# MongoDB URI (Server-side only — optional if backend handles all DB access)
MONGO_URI=
