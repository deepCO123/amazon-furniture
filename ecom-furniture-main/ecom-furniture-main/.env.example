# ==============================================================================
# Amazon Furniture — Frontend Environment Variables Example
# انسخ هذا الملف باسم .env.local للتطوير المحلي، أو ضع هذه المتغيرات في لوحة Vercel
# ==============================================================================

# ── 1. Production URLs ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://amazon-furniture.vercel.app
NEXT_PUBLIC_BACKEND_URL=https://amazon-furniture.onrender.com

# ── 2. MongoDB Atlas (Cloud Database) ─────────────────────────────────────────
# رابط الاتصال بقاعدة بيانات MongoDB Atlas السحابية
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/amazon_furniture?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/amazon_furniture?retryWrites=true&w=majority

# ── 3. Cloudinary Image CDN (تخزين ورفع صور المنتجات السحابي) ───────────────────
# احصل على هذه المفاتيح مجاناً من https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# اختياري: إذا كنت تستخدم Unsigned Upload Preset
# CLOUDINARY_UPLOAD_PRESET=amazon_products

# ── 4. Business Email SMTP (خدمة إرسال إيميلات الفواتير والطلبات) ───────────────
# إعدادات الـ SMTP الرسمية (Gmail App Password أو إيميل نطاق الشركة الخاص)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sales@amazonfurniture.eg
SMTP_PASS=your_app_specific_password_here
EMAIL_FROM="AMAZON للأثاث المكتبي" <sales@amazonfurniture.eg>
ADMIN_EMAIL=admin@amazonfurniture.eg

# ── 5. Marketing Analytics & Tracking (التحليلات وتتبع الإعلانات) ───────────────
# معرف Google Analytics 4 (يبدأ بـ G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# معرف Meta Pixel (Facebook Pixel ID)
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# ── 6. Security ───────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
